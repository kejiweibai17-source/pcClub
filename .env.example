# Google Sheets（唯讀 service account）
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
# 私鑰請用 \n 表示換行，整段放在引號內
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 分頁標題模板，{M} = 月（不補零）。預設：7月份收入
PICKLEBALL_SHEET_TITLE_PATTERN={M}月份收入

# 選填：LINE OA 連結
NEXT_PUBLIC_LINE_OA_URL=https://lin.ee/CBEfgA3
